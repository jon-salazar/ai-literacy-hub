---
import BaseLayout from "../layouts/BaseLayout.astro";
import ProgressTools from "../components/ProgressTools.astro";
import { formatMaturityScore, getMaturityData, MATURITY_SCORE_MAX, MATURITY_SCORE_MIN } from "../lib/maturity";

const maturity = getMaturityData();
const updatedAtLabel = new Date(maturity.updatedAt).toLocaleDateString("pt-BR", { timeZone: "UTC" });
---

<BaseLayout title="Meu progresso">
  <section class="progress-page">
    <div class="container-narrow">
      <h1>Meu progresso</h1>
      <p class="progress-page__intro">
        Este progresso é armazenado apenas neste navegador (localStorage), de forma pseudônima. Não há login nem
        sincronização entre dispositivos.
      </p>

      <div class="progress-page__card" data-progress-summary>
        <p>Carregando progresso...</p>
      </div>

      <ProgressTools />

      <h2>Maturity Map{maturity.demo ? " (conceitual)" : ""}</h2>
      {
        maturity.demo ? (
          <>
            <p>
              Esta seção ilustra, com <strong>dados demonstrativos</strong> (não coletados de participantes reais),
              como os sinais capturados pelos formulários de baseline, evidência e reflexão alimentariam futuramente um
              mapa de maturidade por competência.
            </p>
            <div class="demo-data-badge">Dados demonstrativos</div>
          </>
        ) : (
          <p>Maturidade agregada por competência, a partir dos sinais registrados nos formulários.</p>
        )
      }
      <table class="maturity-table">
        <caption class="visually-hidden">
          {maturity.demo ? "Exemplo demonstrativo de maturidade por competência" : "Maturidade por competência"}
        </caption>
        <thead>
          <tr>
            <th scope="col">Competência</th>
            <th scope="col">Maturidade ({MATURITY_SCORE_MIN}–{MATURITY_SCORE_MAX})</th>
          </tr>
        </thead>
        <tbody>
          {
            maturity.competencies.map((competency) => (
              <tr>
                <th scope="row">{competency.label}</th>
                <td>{formatMaturityScore(competency.score)}</td>
              </tr>
            ))
          }
        </tbody>
      </table>
      {
        maturity.nextIntervention && (
          <p class="maturity-table__note">
            Próxima intervenção sugerida{maturity.demo ? " (exemplo)" : ""}: <strong>{maturity.nextIntervention}</strong>.
          </p>
        )
      }
      <p class="maturity-table__note">
        Atualizado em <time datetime={maturity.updatedAt}>{updatedAtLabel}</time>.
      </p>
    </div>
  </section>
</BaseLayout>

<script>
  import { PROGRESS_CHANGED_EVENT, getProgress } from "../lib/progress";

  function appendLabeled(container: HTMLElement, parts: Array<[string, string]>): void {
    const paragraph = document.createElement("p");
    parts.forEach(([label, value], index) => {
      if (index > 0) paragraph.append(" · ");
      const strong = document.createElement("strong");
      strong.textContent = `${label}:`;
      paragraph.append(strong, ` ${value}`);
    });
    container.appendChild(paragraph);
  }

  function renderSummary(container: HTMLElement): void {
    const progress = getProgress();
    if (!progress) {
      container.textContent = "Não foi possível acessar o armazenamento local deste navegador.";
      return;
    }
    const entries = Object.entries(progress.modules);
    const completed = entries.filter(([, m]) => m.completedAt).length;
    container.replaceChildren();

    appendLabeled(container, [["Participant ID", progress.participantId]]);
    appendLabeled(container, [
      ["Módulos iniciados", String(entries.length)],
      ["Concluídos", String(completed)],
    ]);

    if (entries.length === 0) {
      const empty = document.createElement("p");
      empty.textContent = "Você ainda não iniciou nenhum módulo.";
      container.appendChild(empty);
      return;
    }
    const list = document.createElement("ul");
    for (const [moduleId, moduleProgress] of entries) {
      const item = document.createElement("li");
      const status = moduleProgress.completedAt ? "Concluído" : "Em andamento";
      item.textContent = `${moduleId} — ${status}`;
      list.appendChild(item);
    }
    container.appendChild(list);
  }

  const container = document.querySelector<HTMLElement>("[data-progress-summary]");
  if (container) {
    renderSummary(container);
    document.addEventListener(PROGRESS_CHANGED_EVENT, () => renderSummary(container));
  }
</script>

<style>
  .progress-page {
    padding-block: var(--space-8);
  }

  .progress-page__intro {
    color: var(--color-text-muted);
  }

  .progress-page__card {
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    padding: var(--space-4);
    margin-block: var(--space-6);
  }

  .demo-data-badge {
    display: inline-block;
    margin-bottom: var(--space-3);
    padding: var(--space-1) var(--space-3);
    border-radius: 999px;
    background: color-mix(in srgb, var(--color-warning) 15%, transparent);
    color: var(--color-warning);
    font-weight: 700;
    font-size: var(--font-size-sm);
  }

  .maturity-table {
    width: 100%;
    border-collapse: collapse;
    margin-bottom: var(--space-3);
  }

  .maturity-table th,
  .maturity-table td {
    text-align: left;
    padding: var(--space-2) var(--space-3);
    border-bottom: 1px solid var(--color-border);
  }

  .maturity-table__note {
    color: var(--color-text-muted);
    font-size: var(--font-size-sm);
  }
</style>
