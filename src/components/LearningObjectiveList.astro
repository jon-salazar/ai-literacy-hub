---
interface Props {
  objectives: string[];
}

const { objectives } = Astro.props;
---

{
  objectives.length > 0 && (
    <ul class="objective-list">
      {objectives.map((objective) => (
        <li>{objective}</li>
      ))}
    </ul>
  )
}

<style>
  .objective-list {
    display: grid;
    gap: var(--space-2);
    padding-left: var(--space-6);
    margin: 0;
  }
</style>
