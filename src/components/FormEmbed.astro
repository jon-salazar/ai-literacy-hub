---
import type { FormConfig } from "../lib/forms";
import { formDataAttributes, isFormConfigured } from "../lib/forms";
import ExternalFormCTA from "./ExternalFormCTA.astro";

interface Props {
  config: FormConfig | undefined;
  title: string;
}

const { config, title } = Astro.props;
const configured = isFormConfigured(config);
const shouldEmbed = configured && config!.embed;
const privacyId = configured ? `form-privacy-${config!.moduleId}-${config!.kind}` : undefined;
---

{
  configured && (
    <p class="form-privacy" id={privacyId}>
      <strong>Privacidade (LGPD):</strong> não inclua dados pessoais, de clientes ou informações confidenciais nas
      respostas. O formulário recebe apenas seu identificador pseudônimo e o id do módulo.
    </p>
  )
}

{
  shouldEmbed ? (
    <div class="form-embed">
      <iframe
        title={title}
        data-form-embed
        aria-describedby={privacyId}
        loading="lazy"
        {...formDataAttributes(config!)}
      />
    </div>
  ) : (
    <ExternalFormCTA config={config} label={title} describedBy={privacyId} />
  )
}

<style>
  .form-privacy {
    margin: 0 0 var(--space-3);
    padding: var(--space-3) var(--space-4);
    border-left: 4px solid var(--color-warning);
    background: var(--color-surface);
    font-size: var(--font-size-sm);
  }

  .form-embed {
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    overflow: hidden;
  }

  .form-embed iframe {
    width: 100%;
    min-height: 480px;
    border: 0;
    display: block;
  }
</style>

<script>
  import { getOrCreateParticipantId } from "../lib/progress";
  import { buildFormUrl, formUrlInputFromDataset } from "../lib/forms";

  document.querySelectorAll<HTMLIFrameElement>("iframe[data-form-embed]").forEach((iframe) => {
    const url = buildFormUrl(formUrlInputFromDataset(iframe.dataset), getOrCreateParticipantId());
    if (url) iframe.src = url;
  });
</script>
