---
import type { FormConfig } from "../lib/forms";
import { buildFormUrl, formDataAttributes, isFormConfigured } from "../lib/forms";

interface Props {
  config: FormConfig | undefined;
  label: string;
  /** Id of the element that describes the link (e.g. the privacy notice). */
  describedBy?: string;
}

const { config, label, describedBy } = Astro.props;
const configured = isFormConfigured(config);
// Without JavaScript the link still carries the module id; the client script
// adds the participant id.
const fallbackHref = configured ? buildFormUrl(config!, null) : "";
---

{
  configured ? (
    <a
      class="button form-cta"
      href={fallbackHref}
      target="_blank"
      rel="noopener noreferrer"
      aria-describedby={describedBy}
      data-form-link
      {...formDataAttributes(config!)}
    >
      {label}
      <span class="visually-hidden"> (abre em nova aba)</span>
    </a>
  ) : (
    <p class="form-cta form-cta--pending" role="status">
      <strong>Formulário pendente:</strong> ainda não configurado. Configure a URL em <code>defaults</code> de{" "}
      <code>src/data/forms.json</code>.
    </p>
  )
}

<style>
  .form-cta--pending {
    padding: var(--space-3) var(--space-4);
    border: 1px dashed var(--color-border);
    border-radius: var(--radius-md);
    color: var(--color-text-muted);
    font-size: var(--font-size-sm);
    margin: 0;
  }

  .form-cta--pending code {
    color: var(--color-text);
  }
</style>

<script>
  import { getOrCreateParticipantId } from "../lib/progress";
  import { buildFormUrl, formUrlInputFromDataset } from "../lib/forms";

  document.querySelectorAll<HTMLAnchorElement>("a[data-form-link]").forEach((link) => {
    const url = buildFormUrl(formUrlInputFromDataset(link.dataset), getOrCreateParticipantId());
    if (url) link.href = url;
  });
</script>
