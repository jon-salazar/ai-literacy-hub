---
import StatusBadge from "./StatusBadge.astro";
import type { ModuleEntry } from "../lib/modules";

interface Props {
  module: ModuleEntry;
}

const { module: moduleEntry } = Astro.props;
const { data } = moduleEntry;
const isAvailable = data.status === "published";
---

{
  isAvailable ? (
    <a class="module-card module-card--available" href={`/modulos/${data.slug}`} data-module-id={data.id}>
      <div class="module-card__header">
        <h3 class="module-card__title">{data.title}</h3>
        <StatusBadge status={data.status} />
      </div>
      <p class="module-card__description">{data.description}</p>
      <p class="module-card__meta">{data.duration}</p>
      <p class="module-card__progress" data-module-progress={data.id} hidden>
        Concluído
      </p>
    </a>
  ) : (
    <div class="module-card module-card--disabled" aria-disabled="true">
      <div class="module-card__header">
        <h3 class="module-card__title">{data.title}</h3>
        <StatusBadge status={data.status} />
      </div>
      <p class="module-card__description">{data.description}</p>
      <p class="module-card__meta">{data.duration}</p>
    </div>
  )
}

<style>
  .module-card {
    display: block;
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    padding: var(--space-4);
    text-decoration: none;
    color: var(--color-text);
  }

  .module-card--available:hover {
    border-color: var(--color-primary);
  }

  .module-card--disabled {
    opacity: 0.6;
  }

  .module-card__header {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: var(--space-3);
    margin-bottom: var(--space-2);
  }

  .module-card__title {
    margin: 0;
    font-size: var(--font-size-lg);
  }

  .module-card__description {
    margin: 0 0 var(--space-2);
    color: var(--color-text-muted);
  }

  .module-card__meta {
    margin: 0;
    font-size: var(--font-size-sm);
    color: var(--color-text-muted);
  }

  .module-card__progress {
    margin: var(--space-2) 0 0;
    font-size: var(--font-size-sm);
    font-weight: 600;
    color: var(--color-success);
  }
</style>

<script>
  import { getProgress, isModuleCompleted } from "../lib/progress";

  const progress = getProgress();
  document.querySelectorAll<HTMLElement>("[data-module-progress]").forEach((el) => {
    const moduleId = el.dataset.moduleProgress;
    if (moduleId && isModuleCompleted(progress, moduleId)) {
      el.hidden = false;
    }
  });
</script>
