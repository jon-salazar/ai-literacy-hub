---
interface Props {
  title: string;
  id: string;
  eyebrow?: string;
}

const { title, id, eyebrow } = Astro.props;
---

<section class="learning-section" id={id} aria-labelledby={`${id}-heading`}>
  <div class="container-narrow">
    {eyebrow && <p class="learning-section__eyebrow">{eyebrow}</p>}
    <h2 class="learning-section__title" id={`${id}-heading`}>{title}</h2>
    <div class="learning-section__body">
      <slot />
    </div>
  </div>
</section>

<style>
  .learning-section {
    padding-block: var(--space-8);
    border-bottom: 1px solid var(--color-border);
  }

  .learning-section__eyebrow {
    margin: 0 0 var(--space-1);
    text-transform: uppercase;
    letter-spacing: 0.06em;
    font-size: var(--font-size-sm);
    color: var(--color-text-muted);
    font-weight: 700;
  }

  .learning-section__title {
    margin: 0 0 var(--space-4);
    font-size: var(--font-size-xl);
  }

  .learning-section__body {
    display: grid;
    gap: var(--space-4);
  }

  .learning-section__body :global(p) {
    margin: 0;
    color: var(--color-text);
  }

  .learning-section__body :global(ul),
  .learning-section__body :global(ol) {
    margin: 0;
    padding-left: var(--space-6);
    display: grid;
    gap: var(--space-2);
  }

  .learning-section__body :global(h3) {
    margin: var(--space-2) 0 0;
    font-size: var(--font-size-lg);
  }

  .learning-section__body :global(blockquote) {
    margin: 0;
    padding: var(--space-3) var(--space-4);
    border-left: 3px solid var(--color-primary);
    background: var(--color-surface);
    border-radius: var(--radius-sm);
  }
</style>
